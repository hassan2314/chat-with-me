GEMINI_API_KEY=
GOOGLE_API_KEY=
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://hassan:hassan@localhost:5433/portfolio
ADMIN_SECRET=change-me
# Comma-separated browser origins, or * 
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional. Empty uses the built-in netlify + fastapicloud pattern.
CORS_ORIGIN_REGEX=
PORTFOLIO_URL=https://genuine-kleicha-d80d7d.netlify.app
CHAT_MODEL=gemini-3.6-flash
# Widget and /embed call this origin unless a page overrides it.
PUBLIC_API_URL=https://chat-with-me.fastapicloud.dev
# auto uses Gemini when a key is set, and the local composer otherwise.
LLM_MODE=auto
# Seconds. Boot does not wait longer than this for Postgres to accept a connection.
DB_CONNECT_TIMEOUT=5
DB_READY_WAIT_SECONDS=8
PORT=8000
WIDGET_TITLE=Ask Hassan
WIDGET_SUBTITLE=Questions about my work
WIDGET_ACCENT=#0f5c45
WIDGET_PLACEHOLDER=Ask about a role, a stack, or a project
